# Copy to .env — demo values only, never real secrets.
POSTGRES_USER=dspc
POSTGRES_PASSWORD=dspc-demo-password
POSTGRES_DB=dspc
MINIO_ROOT_USER=dspc-minio
MINIO_ROOT_PASSWORD=dspc-minio-demo-password
MINIO_BUCKET=dspc-documents
# >= 32 chars; demo value, regenerate for anything beyond the stand
JWT_KEY=dspc-demo-jwt-signing-key-change-me-0123456789
DEMO_ENABLED=true
# optional: pin demo clock anchor (ISO date). Empty = Monday of the current week.
DEMO_CLOCK_ANCHOR=
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_AI_MODEL=
WEB_PORT=5173
API_PORT=5080
ENGINE_PORT=8081
