# Production settings for a domain deployment. Copy to .env.prod and fill in.
# Never commit the filled-in file. Generate every secret; do not reuse the demo values.

# ---- domain and TLS -------------------------------------------------------
DSPC_DOMAIN=demo.example.com
DSPC_ACME_EMAIL=ops@example.com
# Leave empty in production (Caddy gets a Let's Encrypt certificate automatically).
# Set to "tls internal" only to rehearse the stack locally.
DSPC_TLS_MODE=
# Extra hostnames the site should answer on, space separated (e.g. "www.example.com").
# A request under a name that is not listed here fails in the TLS handshake
# (the browser shows ERR_SSL_PROTOCOL_ERROR), because no certificate matches it.
DSPC_EXTRA_HOSTS=
# Optional HTTP gate in front of the whole site (see infrastructure/production/Caddyfile)
DSPC_BASIC_AUTH_USER=
DSPC_BASIC_AUTH_HASH=

# ---- secrets: generate all four -------------------------------------------
# openssl rand -base64 48 | tr -d '\n'
JWT_KEY=
# openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# Password for every seeded account. Do NOT leave the built-in "demo".
DEMO_ACCOUNT_PASSWORD=

POSTGRES_USER=dspc
POSTGRES_DB=dspc
MINIO_ROOT_USER=dspc-minio
MINIO_BUCKET=dspc-documents

# ---- demo behaviour -------------------------------------------------------
# false = no auto-login, no role switcher, no /demo/reset; users log in with a password.
# true  = full stand mode. Only behind the Caddy basic_auth gate or on a private network.
DEMO_ENABLED=false
# Seeds the demonstration content even when DEMO_ENABLED=false. Without it the database
# migrates but stays empty and nobody can log in, because the accounts come from the seed.
SEED_FORCE=true
# Pin the demo clock to a fixed week (optional): T0 = Monday of that week.
DEMO_CLOCK_ANCHOR=

# ---- proxy ----------------------------------------------------------------
# Docker's default bridge range. The API trusts X-Forwarded-* only from these networks,
# so rate limiting and the audit trail see the real client address.
TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# ---- optional local AI ----------------------------------------------------
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
